import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        boolean result = false;
        Set<Character>  set = new LinkedHashSet<>();
        for(int i =0;i<s.length();i++){
            char ch = s.charAt(i);
              if(set.contains(ch)){
                  System.out.print("-");
              }
            else{
                System.out.print(ch);
            }
            set.add(ch);
        }
        
        
    }
}
