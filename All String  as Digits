import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        int count = 0;
        for(int i =0;i<s.length();i++){
            if(Character.isDigit(s.charAt(i))){
                count++;
               
            }
        }
        if(count==s.length()){
            System.out.println("true");
        }
        else{
            System.out.println("false");
        }
    }
}
