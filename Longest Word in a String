import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        String[] str = s.split(" ");
        String longest = "";
        for(int i =0;i<str.length;i++){
            if(str[i].length()>longest.length()){
                longest = str[i];
            }
        }
        System.out.print(longest);
    }
}
