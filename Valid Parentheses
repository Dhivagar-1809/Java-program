class Solution {
    public boolean isValid(String s) {
        if(!s.isEmpty()){
            if(s.contains("{}"))   s=s.replace("{}","");
            else if(s.contains("[]"))   s=s.replace("[]","");
            else if(s.contains("()"))   s=s.replace("()","");
              else return false;
        }
        return true;
        
    }
} 
            
            
            
            
            
          
